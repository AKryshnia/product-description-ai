# Скопируйте в .env (файл .env в git не попадает) и заполните GIGACHAT_CREDENTIALS.

# --- Провайдер и модель (общие параметры, не зависят от провайдера) ---------------------
# Сейчас реализован и проверен один провайдер: gigachat.
LLM_PROVIDER=gigachat
# Идентификатор модели. Если не задан — умолчание провайдера (для gigachat: GigaChat-2-Pro).
# Доступные вашему ключу модели: python scripts/live_check.py --models
LLM_MODEL=GigaChat-2-Pro
# 0.0 — воспроизводимый результат (на 0.2 длина текста заметно плавает, см. README)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
# Таймаут одного HTTP-запроса (сек) и число повторов при временных сбоях (429/5xx/сеть).
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# --- Доступ к GigaChat -------------------------------------------------------------------
# Ключ авторизации (Authorization key) из личного кабинета GigaChat API — строка в base64.
# НИКОГДА не коммитьте и не вставляйте в чаты/логи.
GIGACHAT_CREDENTIALS=

# Тип доступа: GIGACHAT_API_PERS (физлица) | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Базовый URL API. Проверенное значение по умолчанию; в новой документации Сбера также встречается
# https://api.giga.chat/v1 (из некоторых сетей он может быть недоступен).
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

# Корневой сертификат НУЦ Минцифры (Russian Trusted Root CA) — нужен для TLS-проверки.
# Проверку сертификатов отключать НЕЛЬЗЯ; как скачать сертификат — в README.
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt
